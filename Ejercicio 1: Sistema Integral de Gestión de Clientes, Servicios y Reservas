from abc import ABC, abstractmethod
from datetime import datetime


# ==========================================================
# PARTE 1: ARCHIVO DE LOGS
# Cada error o evento importante se guarda en "log.txt"
# ==========================================================
def escribir_log(tipo, mensaje):
    # tipo puede ser "INFO" o "ERROR"
    fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    archivo = open("log.txt", "a", encoding="utf-8")  # "a" = agregar al final
    archivo.write(fecha + " | " + tipo + " | " + mensaje + "\n")
    archivo.close()

# ==========================================================
# PARTE 2: EXCEPCIONES PERSONALIZADAS
# Son errores creados por nosotros. Todas heredan de Exception.
# ==========================================================
class ErrorFJ(Exception):
    """Error general del sistema (las demas heredan de esta)"""
    pass


class ClienteInvalidoError(ErrorFJ):
    pass


class ServicioInvalidoError(ErrorFJ):
    pass


class ServicioNoDisponibleError(ErrorFJ):
    pass


class ReservaInvalidaError(ErrorFJ):
    pass


class OperacionNoPermitidaError(ErrorFJ):
    pass


class CalculoInconsistenteError(ErrorFJ):
    pass
