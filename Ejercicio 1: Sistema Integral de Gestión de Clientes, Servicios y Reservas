from abc import ABC, abstractmethod
from datetime import datetime


# ==========================================================
# PARTE 1: ARCHIVO DE LOGS
# Cada error o evento importante se guarda en "log.txt"
# ==========================================================
def escribir_log(tipo, mensaje):
    # tipo puede ser "INFO" o "ERROR"
    fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    archivo = open("log.txt", "a", encoding="utf-8")  # "a" = agregar al final
    archivo.write(fecha + " | " + tipo + " | " + mensaje + "\n")
    archivo.close()

# ==========================================================
# PARTE 2: EXCEPCIONES PERSONALIZADAS
# Son errores creados por nosotros. Todas heredan de Exception.
# ==========================================================
class ErrorFJ(Exception):
    """Error general del sistema (las demas heredan de esta)"""
    pass


class ClienteInvalidoError(ErrorFJ):
    pass


class ServicioInvalidoError(ErrorFJ):
    pass



# ==========================================================
# PARTE 3: CLASE ABSTRACTA ENTIDAD Y CLASE CLIENTE
# Entidad es una clase abstracta: no se puede crear directamente,
# solo sirve de molde para Cliente, Servicio y Reserva.
# ==========================================================
class Entidad(ABC):
    def __init__(self, id_entidad):
        self._id = id_entidad

    def get_id(self):
        return self._id

    @abstractmethod
    def describir(self):
        # Las clases hijas estan obligadas a escribir este metodo
        pass


class Cliente(Entidad):
    def __init__(self, id_cliente, nombre, correo, telefono):
        super().__init__(id_cliente)

        # Validaciones: si algo esta mal, lanzamos el error
        if nombre == "" or nombre is None:
            raise ClienteInvalidoError("El nombre no puede estar vacio")
        if "@" not in correo or "." not in correo:
            raise ClienteInvalidoError("El correo '" + correo + "' no es valido")
        if not telefono.isdigit() or len(telefono) < 7:
            raise ClienteInvalidoError("El telefono debe tener solo numeros (minimo 7)")

        # Los dos guiones bajos (__) hacen el atributo privado (encapsulacion)
        self.__nombre = nombre
        self.__correo = correo
        self.__telefono = telefono

    def get_nombre(self):
        return self.__nombre

    def get_correo(self):
        return self.__correo

    def describir(self):
        return "Cliente " + str(self._id) + ": " + self.__nombre + " (" + self.__correo + ")"

class ServicioNoDisponibleError(ErrorFJ):
    pass


class ReservaInvalidaError(ErrorFJ):
    pass


class OperacionNoPermitidaError(ErrorFJ):


# ==========================================================
# PARTE 4: CLASE ABSTRACTA SERVICIO Y SUS 3 HIJAS
# Cada servicio calcula su costo de forma diferente (polimorfismo)
# ==========================================================
class Servicio(Entidad):
    def __init__(self, id_servicio, nombre, precio_hora):
        super().__init__(id_servicio)
        if nombre == "":
            raise ServicioInvalidoError("El servicio necesita un nombre")
        if precio_hora <= 0:
            raise ServicioInvalidoError("El precio por hora debe ser mayor a 0")
        self._nombre = nombre
        self._precio_hora = precio_hora
        self._disponible = True

    def get_nombre(self):
        return self._nombre

    def esta_disponible(self):
        return self._disponible

    def set_disponible(self, valor):
        self._disponible = valor

    # Metodos abstractos: cada hijo los escribe a su manera
    @abstractmethod
    def validar(self, horas):
        pass

    @abstractmethod
    def costo_base(self, horas):
        pass

    # "Sobrecarga": Python no la tiene como Java, pero se imita con
    # parametros opcionales. Se puede llamar de 4 formas:
    #   calcular_costo(2)                         -> solo costo base
    #   calcular_costo(2, descuento=0.1)          -> con descuento (10%)
    #   calcular_costo(2, impuesto=0.19)          -> con impuesto (19%)
    #   calcular_costo(2, 0.1, 0.19)              -> con los dos
    def calcular_costo(self, horas, descuento=0, impuesto=0):
        self.validar(horas)
        if descuento < 0 or descuento >= 1:
            raise CalculoInconsistenteError("El descuento debe estar entre 0 y 1")
        if impuesto < 0:
            raise CalculoInconsistenteError("El impuesto no puede ser negativo")
        total = self.costo_base(horas) * (1 - descuento) * (1 + impuesto)
        return round(total, 2)


class SalaReunion(Servicio):
    def __init__(self, id_servicio, nombre, precio_hora, capacidad):
        super().__init__(id_servicio, nombre, precio_hora)
        self.__capacidad = capacidad

    def validar(self, horas):
        if horas < 1 or horas > 12:
            raise ServicioInvalidoError("La sala se reserva entre 1 y 12 horas")

    def costo_base(self, horas):
        return self._precio_hora * horas

    def describir(self):
        return "Sala " + self._nombre + " (capacidad " + str(self.__capacidad) + ")"


class AlquilerEquipo(Servicio):
    def __init__(self, id_servicio, nombre, precio_hora, stock):
        super().__init__(id_servicio, nombre, precio_hora)
        self.__stock = stock

    def validar(self, horas):
        if horas < 1 or horas > 72:
            raise ServicioInvalidoError("El equipo se alquila entre 1 y 72 horas")

    def costo_base(self, horas):
        return self._precio_hora * horas

    def describir(self):
        return "Equipo " + self._nombre + " (stock " + str(self.__stock) + ")"


class Asesoria(Servicio):
    def __init__(self, id_servicio, nombre, precio_hora, especialidad):
        super().__init__(id_servicio, nombre, precio_hora)
        self.__especialidad = especialidad

    def validar(self, horas):
        if horas < 0.5 or horas > 8:
            raise ServicioInvalidoError("La asesoria dura entre 0.5 y 8 horas")

    def costo_base(self, horas):
        # La asesoria cuesta 20% mas que el precio normal (ejemplo de polimorfismo)
        return self._precio_hora * horas * 1.2

    def describir(self):
        return "Asesoria " + self._nombre + " (" + self.__especialidad + ")"

    pass


class CalculoInconsistenteError(ErrorFJ):
    pass


# ==========================================================
# PARTE 5: CLASE RESERVA
# Une cliente + servicio + duracion + estado.
# Estados: PENDIENTE -> CONFIRMADA -> PROCESADA (o CANCELADA)
# ==========================================================
class Reserva(Entidad):
    def __init__(self, id_reserva, cliente, servicio, horas):
        super().__init__(id_reserva)
        if not isinstance(cliente, Cliente):
            raise ReservaInvalidaError("La reserva necesita un cliente valido")
        if not isinstance(servicio, Servicio):
            raise ReservaInvalidaError("La reserva necesita un servicio valido")
        if horas <= 0:
            raise ReservaInvalidaError("Las horas deben ser mayores a 0")
        self.__cliente = cliente
        self.__servicio = servicio
        self.__horas = horas
        self.__estado = "PENDIENTE"
        self.__total = 0

    def get_estado(self):
        return self.__estado

    # try / except / else / finally
    def confirmar(self):
        try:
            if self.__estado != "PENDIENTE":
                raise OperacionNoPermitidaError("Solo se confirman reservas PENDIENTES")
            if not self.__servicio.esta_disponible():
                raise ServicioNoDisponibleError("El servicio no esta disponible")
            self.__servicio.validar(self.__horas)
        except ErrorFJ as e:
            escribir_log("ERROR", "No se pudo confirmar " + str(self._id) + ": " + str(e))
            raise  # volvemos a lanzar el error para que lo vea quien llamo
        else:
            # Se ejecuta solo si NO hubo error
            self.__estado = "CONFIRMADA"
            escribir_log("INFO", "Reserva " + str(self._id) + " confirmada")
        finally:
            # Se ejecuta SIEMPRE
            escribir_log("INFO", "Fin del intento de confirmar " + str(self._id))

    def cancelar(self):
        if self.__estado == "PROCESADA":
            raise OperacionNoPermitidaError("No se puede cancelar una reserva procesada")
        if self.__estado == "CANCELADA":
            raise OperacionNoPermitidaError("La reserva ya estaba cancelada")
        self.__estado = "CANCELADA"
        escribir_log("INFO", "Reserva " + str(self._id) + " cancelada")

    def procesar(self, descuento=0):
        if self.__estado != "CONFIRMADA":
            raise OperacionNoPermitidaError("Solo se procesan reservas CONFIRMADAS")
        try:
            self.__total = self.__servicio.calcular_costo(self.__horas, descuento, 0.19)
        except ErrorFJ as e:
            escribir_log("ERROR", "Error calculando " + str(self._id) + ": " + str(e))
            # ENCADENAMIENTO: "from e" guarda el error original como causa
            raise ReservaInvalidaError("No se pudo procesar la reserva " + str(self._id)) from e
        else:
            self.__estado = "PROCESADA"
            escribir_log("INFO", "Reserva " + str(self._id) + " procesada. Total: " + str(self.__total))
            return self.__total

    def describir(self):
        return ("Reserva " + str(self._id) + ": " + self.__cliente.get_nombre() + " -> "
                + self.__servicio.get_nombre() + " | " + str(self.__horas) + "h | "
                + self.__estado + " | Total: " + str(self.__total))
