from abc import ABC, abstractmethod
from datetime import datetime


# ==========================================================
# PARTE 1: ARCHIVO DE LOGS
# Cada error o evento importante se guarda en "log.txt"
# ==========================================================
def escribir_log(tipo, mensaje):
    # tipo puede ser "INFO" o "ERROR"
    fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    archivo = open("log.txt", "a", encoding="utf-8")  # "a" = agregar al final
    archivo.write(fecha + " | " + tipo + " | " + mensaje + "\n")
    archivo.close()

# ==========================================================
# PARTE 2: EXCEPCIONES PERSONALIZADAS
# Son errores creados por nosotros. Todas heredan de Exception.
# ==========================================================
class ErrorFJ(Exception):
    """Error general del sistema (las demas heredan de esta)"""
    pass


class ClienteInvalidoError(ErrorFJ):
    pass


class ServicioInvalidoError(ErrorFJ):
    pass



# ==========================================================
# PARTE 3: CLASE ABSTRACTA ENTIDAD Y CLASE CLIENTE
# Entidad es una clase abstracta: no se puede crear directamente,
# solo sirve de molde para Cliente, Servicio y Reserva.
# ==========================================================
class Entidad(ABC):
    def __init__(self, id_entidad):
        self._id = id_entidad

    def get_id(self):
        return self._id

    @abstractmethod
    def describir(self):
        # Las clases hijas estan obligadas a escribir este metodo
        pass


class Cliente(Entidad):
    def __init__(self, id_cliente, nombre, correo, telefono):
        super().__init__(id_cliente)

        # Validaciones: si algo esta mal, lanzamos el error
        if nombre == "" or nombre is None:
            raise ClienteInvalidoError("El nombre no puede estar vacio")
        if "@" not in correo or "." not in correo:
            raise ClienteInvalidoError("El correo '" + correo + "' no es valido")
        if not telefono.isdigit() or len(telefono) < 7:
            raise ClienteInvalidoError("El telefono debe tener solo numeros (minimo 7)")

        # Los dos guiones bajos (__) hacen el atributo privado (encapsulacion)
        self.__nombre = nombre
        self.__correo = correo
        self.__telefono = telefono

    def get_nombre(self):
        return self.__nombre

    def get_correo(self):
        return self.__correo

    def describir(self):
        return "Cliente " + str(self._id) + ": " + self.__nombre + " (" + self.__correo + ")"

class ServicioNoDisponibleError(ErrorFJ):
    pass


class ReservaInvalidaError(ErrorFJ):
    pass


class OperacionNoPermitidaError(ErrorFJ):
    pass


class CalculoInconsistenteError(ErrorFJ):
    pass
